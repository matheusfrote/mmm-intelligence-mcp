include server.py
include LICENSE NOTICE CONTRIBUTING.md CODE_OF_CONDUCT.md SECURITY.md
include requirements-lock.txt
include .env.example
include .gitignore
include IMPLEMENTATION_PROGRESS.md
include CHANGELOG.md
include package.json package-lock.json
include .dockerignore deploy/Dockerfile
include SECURITY_DEPLOY_AUDIT.md
include MMM_*.md
recursive-include docs *.md
recursive-include examples *.py *.example.json *.csv
recursive-include tests *.py
recursive-include tests/web *.mjs
