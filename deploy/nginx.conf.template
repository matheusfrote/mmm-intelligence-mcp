# Render with a reviewed MMM_PUBLIC_HOST and existing TLS certificate paths.
# This template exposes ONLY the authenticated /mcp route. Never proxy /app.
server {
    listen 443 ssl;
    server_name ${MMM_PUBLIC_HOST};
    ssl_certificate ${MMM_TLS_CERTIFICATE};
    ssl_certificate_key ${MMM_TLS_KEY};
    ssl_protocols TLSv1.2 TLSv1.3;
    client_max_body_size 4m;
    add_header Strict-Transport-Security "max-age=31536000" always;
    add_header X-Content-Type-Options nosniff always;
    location = /mcp {
        # This public route is for MCP clients, not browser cross-origin access.
        if ($http_origin != "") { return 403; }
        proxy_pass http://127.0.0.1:8769/mcp;
        proxy_http_version 1.1;
        proxy_set_header Host 127.0.0.1:8769;
        proxy_set_header Authorization $http_authorization;
        proxy_set_header Connection "";
        proxy_buffering off;
        proxy_read_timeout 960s;
    }
    location / { return 404; }
}
