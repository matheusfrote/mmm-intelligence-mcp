# Host/operator configuration. No dotenv loading; set environment variables explicitly.
MMM_DATA_DIR=./var
MMM_ALLOW_REAL_DATA=false
MMM_MAX_ROWS=10000
MMM_MAX_FILE_BYTES=10485760
MMM_LOG_LEVEL=INFO
MMM_TRANSPORT=stdio
MMM_PORT=8769
MMM_HTTP_REQUESTS_PER_MINUTE=120
MMM_HTTP_UNAUTH_PER_MINUTE=30
MMM_HTTP_MAX_CONCURRENT=4
# Configure users/hashes explicitly before enabling loopback HTTP.
MMM_BACKEND_TIMEOUT_SECONDS=900
MMM_WORKER_CPU_PERCENT=50
MMM_WORKER_MEMORY_MB=4096
# Set absolute paths when using a wheel or another client working directory.
# MMM_MERIDIAN_PYTHON=C:/project/var/envs/meridian/Scripts/python.exe
# MMM_PYMC_PYTHON=C:/project/var/envs/pymc/Scripts/python.exe
# MMM_ROBYN_PYTHON=C:/project/var/envs/robyn/Scripts/python.exe
# MMM_RSCRIPT=C:/project/var/runtime/r-portable/R-4.5.2/bin/Rscript.exe
